<%@page pageEncoding="UTF-8"%>
<%@page import="java.util.*"%><%@include file="/WEB-INF/include/header.jsp"%>
<section class="panel"><span class="eyebrow">YOUR CINEMA PLANS</span><h1 class="page-title">Đơn đặt vé</h1><p class="muted">Đơn chưa thanh toán giữ ghế trong 10 phút. Giá cuối cùng đã bao gồm ưu đãi hợp lệ.</p>
<%if(request.getAttribute("error")!=null){%><p class="alert alert-error"><%=Html.e(request.getAttribute("error"))%></p><%}%>
<%if(request.getAttribute("success")!=null){%><p class="alert alert-success" role="status"><%=Html.e(request.getAttribute("success"))%></p><%}%>
<%if(Boolean.TRUE.equals(request.getAttribute("demoPaymentEnabled"))){%><p class="alert alert-info">Đang bật chế độ kiểm thử: nút giả lập phát hành vé trong database nhưng không thu tiền thật.</p><%}%>
<%List<Map<String,Object>>orders=(List<Map<String,Object>>)request.getAttribute("orders");if(orders==null||orders.isEmpty()){%><p>Chưa có đơn đặt vé.</p><%}else for(Map<String,Object>o:orders){String state=String.valueOf(o.get("paymentState"));%>
<article class="panel" style="margin-bottom:18px"><div class="toolbar"><div><span class="ticket-code"><%=Html.e(o.get("orderID"))%></span><h2><%=Html.e(o.get("title"))%></h2><p class="muted"><%=Html.e(o.get("roomName"))%> · <%=Html.e(o.get("showDate"))%> · <%=Html.e(o.get("startTime"))%></p></div><div><strong><%=new java.text.DecimalFormat("#,###").format(o.get("totalAmount"))%> VNĐ</strong><p>Giảm: <%=Html.e(o.get("discount"))%> VNĐ</p></div></div>
<%if(((Number)o.get("demoPayment")).intValue()==1){%><p class="badge">GIAO DỊCH GIẢ LẬP · Không thu tiền thật</p><%}%>
<p class="badge"><%=state.equals("PAID")?"Đã thanh toán":state.equals("PENDING")?"Chờ thanh toán":state.equals("EXPIRED")?"Hết hạn giữ ghế":"Thanh toán không thành công"%></p>
<%if(state.equals("PENDING")){%><p>Hết hạn lúc <%=Html.e(o.get("expiresAt"))%> (giờ máy chủ rạp).</p><form accept-charset="UTF-8" method="post"><input type="hidden" name="csrf" value="<%=session.getAttribute("CSRF")%>"><input type="hidden" name="orderID" value="<%=Html.e(o.get("orderID"))%>"><%if(Boolean.TRUE.equals(request.getAttribute("paymentConfigured"))){%><button class="btn btn-primary" name="action" value="vnpay">Thanh toán qua VNPay</button><%}else{%><p class="alert alert-error">VNPay chưa được cấu hình. Nếu đang kiểm thử, bạn có thể dùng nút giả lập bên dưới.</p><%}%><%if(Boolean.TRUE.equals(request.getAttribute("demoPaymentEnabled"))){%><button class="btn btn-soft" name="action" value="simulate">Giả lập đã thanh toán thành công</button><%}%></form><%}else if(state.equals("PAID")){%><a class="btn btn-soft" href="<%=headerCtx%>/booking/history">Xem vé đã phát hành</a><%}%></article><%}%></section>
<%@include file="/WEB-INF/include/footer.jsp"%>
